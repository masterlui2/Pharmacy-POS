@model IReadOnlyList<PharmacyPOS.Models.HomeHeroSlideViewModel>

@if (Model.Count > 0)
{
    var primarySlide = Model[0];
    var secondarySlide = Model.Count > 1 ? Model[1] : Model[0];
    var tertiaryImagePath = Url.Content("~/images/hero.png");

    <section class="homepage-hero-showcase" aria-label="Homepage promotions">
        <a class="homepage-hero-showcase__primary" href="#">
            <img src="@Url.Content(primarySlide.ImagePath)" alt="@primarySlide.Title" />
        </a>

        <div class="homepage-hero-showcase__aside">
            <a class="homepage-hero-showcase__secondary" href="#">
                <img src="@Url.Content(secondarySlide.ImagePath)" alt="@secondarySlide.Title" />
            </a>

            <a class="homepage-hero-showcase__tertiary" href="#">
                <img src="@tertiaryImagePath" alt="Featured SafeMed promotion" />
            </a>
        </div>
    </section>
}
