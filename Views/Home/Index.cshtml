@model PharmacyPOS.Models.HomeIndexViewModel

@{
    ViewData["Title"] = "Online Pharmacy";
}

@section Styles {
    <link rel="stylesheet" href="~/css/homepage-hero.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/homepage-categories.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/homepage-promos.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/homepage.css" asp-append-version="true" />
}

@await Html.PartialAsync("_HeroBanner", Model.HeroSlides)
@await Html.PartialAsync("_CategoryStrip", Model.Categories)
@await Html.PartialAsync("_PromoPanels", Model.PromoPanels)

<section class="homepage-medicines">
    <div class="homepage-medicines__header">
        <div>
            <span class="homepage-medicines__eyebrow">Featured Medicines</span>
            <h2 class="homepage-medicines__title">Medicine care essentials for everyday needs</h2>
        </div>
    </div>

    <div class="homepage-medicines__grid">
        @foreach (var medicine in Model.FeaturedMedicines)
        {
            @await Html.PartialAsync("_MedicineCard", medicine)
        }
    </div>
</section>
