@model PharmacyPOS.Models.FeaturedMedicineCardViewModel

<article class="medicine-spotlight-card"
         data-cart-product
         data-product-id="@Model.Id"
         data-product-name="@Model.ProductName"
         data-product-brand="@Model.BrandName"
         data-product-image="@Url.Content(Model.ImagePath)"
         data-product-price="@Model.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
         data-product-tax="@Model.IncludedTax.ToString(System.Globalization.CultureInfo.InvariantCulture)"
         data-product-rx="@Model.RequiresPrescription.ToString().ToLowerInvariant()">
    <div class="medicine-spotlight-card__image-wrap">
        <button type="button" class="medicine-spotlight-card__wish" data-wishlist-toggle aria-label="Save to wishlist">
            <i class="bi bi-heart"></i>
        </button>
        <img class="medicine-spotlight-card__image" src="@Url.Content(Model.ImagePath)" alt="@Model.BrandName" />
    </div>

    <div class="medicine-spotlight-card__meta-bar">
        <span class="medicine-spotlight-card__category">@Model.CategoryLabel</span>
        <span class="medicine-spotlight-card__quantity">
            <strong>@Model.QuantityLabel</strong>
            <i class="bi bi-capsule-pill" aria-hidden="true"></i>
        </span>
    </div>

    <div class="medicine-spotlight-card__body">
        <h2 class="medicine-spotlight-card__brand">@Model.BrandName</h2>
        <p class="medicine-spotlight-card__name">@Model.ProductName</p>
        @if (Model.RequiresPrescription)
        {
            <p class="medicine-spotlight-card__rx-note">Prescription upload required upon checkout</p>
        }
    </div>

    <div class="medicine-spotlight-card__purchase">
        <div class="medicine-spotlight-card__quantity-picker" aria-label="Quantity selector">
            <button type="button" aria-label="Decrease quantity" data-qty-decrease>-</button>
            <span data-qty-value>1</span>
            <button type="button" aria-label="Increase quantity" data-qty-increase>+</button>
        </div>
        <div class="medicine-spotlight-card__price">@Model.PriceLabel</div>
    </div>

    <div class="medicine-spotlight-card__footer">
        <button class="medicine-spotlight-card__cta" type="button" data-add-to-cart>Add to Cart</button>
        <button class="medicine-spotlight-card__secondary" type="button" data-wishlist-toggle>
            <i class="bi bi-heart"></i>
            <span>Wishlist</span>
        </button>
    </div>
</article>
