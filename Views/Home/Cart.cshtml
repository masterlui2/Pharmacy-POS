@{
    ViewData["Title"] = "My Cart";
}

<section class="cart-page" data-cart-page>
    <div class="cart-page__shell" data-cart-root>
        <div class="cart-page__empty-state">
            <h2>Your cart is empty</h2>
            <p>Add medicines from the homepage and they will appear here.</p>
            <a class="cart-page__continue-link" asp-controller="Home" asp-action="Index">Continue Shopping</a>
        </div>
    </div>
</section>
