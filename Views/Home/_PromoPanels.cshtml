@model IReadOnlyList<PharmacyPOS.Models.HomePromoPanelViewModel>

@if (Model.Count > 0)
{
    <section class="homepage-promo-panels" aria-label="Prescription and OTC promotions">
        @foreach (var panel in Model)
        {
            <a class="homepage-promo-card" href="#" aria-label="@($"{panel.TitlePrimary} {panel.TitleAccent}")">
                <img src="@Url.Content(panel.ImagePath)" alt="@($"{panel.TitlePrimary} {panel.TitleAccent}")" />
            </a>
        }
    </section>
}
