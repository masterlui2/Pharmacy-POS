@model PharmacyPOS.Models.Admin.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="pos-topbar">
    <div class="pos-greeting">
        <h3>Welcome back, @Model.Username</h3>
        <small>Real-time pharmacy operations snapshot across orders, revenue, and inventory.</small>
    </div>
    <div class="admin-topbar-badge">Live admin panel</div>
</div>

<section class="admin-stat-grid">
    <article class="admin-stat-card admin-stat-card--accent">
        <span class="admin-stat-card__label">Total revenue</span>
        <strong>&#8369;@Model.TotalRevenue.ToString("N2")</strong>
        <small>&#8369;@Model.MonthlyRevenue.ToString("N2") this month</small>
    </article>
    <article class="admin-stat-card">
        <span class="admin-stat-card__label">Orders</span>
        <strong>@Model.TotalOrders</strong>
        <small>@Model.PaidOrders paid, @Model.PendingOrders pending</small>
    </article>
    <article class="admin-stat-card">
        <span class="admin-stat-card__label">Customers</span>
        <strong>@Model.TotalCustomers</strong>
        <small>@Model.PrescriptionOrders prescription orders recorded</small>
    </article>
    <article class="admin-stat-card">
        <span class="admin-stat-card__label">Inventory</span>
        <strong>@Model.TotalMedicines</strong>
        <small>@Model.LowStockMedicines low stock, @Model.OutOfStockMedicines out of stock</small>
    </article>
</section>

<section class="admin-panel-grid">
    <article class="admin-panel admin-panel--wide">
        <div class="admin-panel__header">
            <div>
                <h4>Business Overview</h4>
                <p>Core metrics pulled from current order and payment records.</p>
            </div>
        </div>

        <div class="admin-kpi-grid">
            <div class="admin-kpi">
                <span>Average order value</span>
                <strong>&#8369;@Model.AverageOrderValue.ToString("N2")</strong>
            </div>
            <div class="admin-kpi">
                <span>Paid orders</span>
                <strong>@Model.PaidOrders</strong>
            </div>
            <div class="admin-kpi">
                <span>Pending orders</span>
                <strong>@Model.PendingOrders</strong>
            </div>
            <div class="admin-kpi">
                <span>Prescription orders</span>
                <strong>@Model.PrescriptionOrders</strong>
            </div>
        </div>

        <div class="admin-breakdown-list">
            @if (Model.RevenueByPaymentMethod.Count == 0)
            {
                <div class="admin-empty-state">No payment data yet.</div>
            }
            else
            {
                @foreach (var item in Model.RevenueByPaymentMethod)
                {
                    <div class="admin-breakdown-item">
                        <div class="admin-breakdown-item__meta">
                            <strong>@item.Label</strong>
                            <span>&#8369;@item.Amount.ToString("N2")</span>
                        </div>
                        <div class="admin-progress">
                            <div class="admin-progress__fill" style="width:@item.Percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>
                    </div>
                }
            }
        </div>
    </article>

    <article class="admin-panel">
        <div class="admin-panel__header">
            <div>
                <h4>Top Selling Medicines</h4>
                <p>Best performers based on sold quantity.</p>
            </div>
        </div>

        @if (Model.TopProducts.Count == 0)
        {
            <div class="admin-empty-state">No product sales recorded yet.</div>
        }
        else
        {
            <div class="admin-product-list">
                @foreach (var product in Model.TopProducts)
                {
                    <div class="admin-product-row">
                        <div>
                            <strong>@product.ProductName</strong>
                            <span>@product.QuantitySold sold</span>
                        </div>
                        <strong>&#8369;@product.Revenue.ToString("N2")</strong>
                    </div>
                }
            </div>
        }
    </article>
</section>

<section class="admin-panel-grid admin-panel-grid--secondary">
    <article class="admin-panel admin-panel--wide">
        <div class="admin-panel__header">
            <div>
                <h4>Recent Orders</h4>
                <p>Latest transactions from the storefront and checkout flow.</p>
            </div>
        </div>

        @if (Model.RecentOrders.Count == 0)
        {
            <div class="admin-empty-state">No orders have been placed yet.</div>
        }
        else
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Customer</th>
                            <th>Status</th>
                            <th>Payment</th>
                            <th>Total</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.RecentOrders)
                        {
                            <tr>
                                <td>@order.OrderNumber</td>
                                <td>@order.CustomerName</td>
                                <td><span class="admin-badge">@order.OrderStatus</span></td>
                                <td>@order.PaymentStatus</td>
                                <td>&#8369;@order.TotalAmount.ToString("N2")</td>
                                <td>@order.CreatedAtUtc.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </article>

    <article class="admin-panel">
        <div class="admin-panel__header">
            <div>
                <h4>Inventory Alerts</h4>
                <p>Items requiring attention from the inventory side.</p>
            </div>
        </div>

        @if (Model.InventoryAlerts.Count == 0)
        {
            <div class="admin-empty-state">Inventory is stable right now.</div>
        }
        else
        {
            <ul class="admin-alert-list">
                @foreach (var alert in Model.InventoryAlerts)
                {
                    <li>@alert</li>
                }
            </ul>
        }
    </article>
</section>
