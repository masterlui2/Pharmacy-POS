@{
    var currentController = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).ToLowerInvariant();
    var isLoggedIn = !string.IsNullOrWhiteSpace(Context.Session.GetString("Username"));
    var showCategoryNav = currentController != "auth";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SafeMed Pharmacy</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/storefront.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PharmacyPOS.styles.css" asp-append-version="true" />
    
</head>
<body>
    <div class="storefront-shell">
        <div class="storefront-utility-bar">
            <div class="storefront-container storefront-utility-inner">
                <span>Look Good. Do Good. Feel Great</span>
                <div class="storefront-utility-links">
                    <a href="#">Download the app</a>
                    <a href="#">Our Stores</a>
                    <a href="#">Store Locator</a>
                </div>
            </div>
        </div>

        <header class="storefront-header">
            <div class="storefront-container storefront-header-inner">
                <div class="storefront-search-wrap">
                    <button class="storefront-search-trigger" type="button" aria-label="Search">
                        <i class="bi bi-search"></i>
                    </button>
                    <div class="storefront-search-box">
                        <input type="search" placeholder="Search medicines, brands, and wellness essentials" />
                    </div>
                </div>

                <a class="storefront-logo" asp-controller="Home" asp-action="Index" aria-label="SafeMed home">
                    <img src="~/images/logo.png" alt="SafeMed Pharmacy" />
                </a>

                <div class="storefront-actions">
                    @if (isLoggedIn)
                    {
                        <a class="storefront-action-link" href="#">
                            <i class="bi bi-person"></i>
                            <span>@Context.Session.GetString("Username")</span>
                        </a>
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="storefront-inline-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="storefront-action-link storefront-action-button">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Logout</span>
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="storefront-login-menu">
                            <a class="storefront-action-link" asp-controller="Auth" asp-action="Login">
                                <i class="bi bi-person"></i>
                                <span>Login</span>
                            </a>
                            <div class="storefront-login-dropdown">
                                <a class="storefront-login-cta" href="#">
                                    <span>Create Account</span>
                                </a>
                                <a class="storefront-login-cta" asp-controller="Auth" asp-action="Login">
                                    <span>Login / Sign Up</span>
                                </a>
                                <div class="storefront-login-links">
                                    <a href="#"><i class="bi bi-person"></i><span>My Account</span></a>
                                    <a href="#"><i class="bi bi-heart"></i><span>Wish List</span></a>
                                    <a href="#"><i class="bi bi-box-seam"></i><span>My Orders</span></a>
                                </div>
                                <a class="storefront-login-chat" href="#">
                                    <i class="bi bi-chat-dots"></i>
                                    <span>Chat with Us</span>
                                </a>
                            </div>
                        </div>
                    }
                    <a class="storefront-action-link storefront-bag-link" asp-controller="Home" asp-action="Cart">
                            <i class="bi bi-bag"></i>
                            <span>My CART</span>
                            <strong>0</strong>
                    </a>
                </div>
            </div>
        </header>

        @if (showCategoryNav)
        {
            <nav class="storefront-category-nav">
                <div class="storefront-container storefront-category-links">
                    <a asp-controller="Home" asp-action="Index">Online Pharmacy</a>
                    <a href="#">Vitamins</a>
                    @if (isLoggedIn)
                    {
                        <a asp-controller="Dashboard" asp-action="Index">Admin Panel</a>
                        <a asp-controller="Medicines" asp-action="Index">Inventory</a>
                    }
                    <a href="#">All Brands</a>
                </div>
            </nav>
        }

        <div class="storefront-page">
            <main class="storefront-container storefront-content-area">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
