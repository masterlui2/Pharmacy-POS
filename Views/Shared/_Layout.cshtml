@{
    var currentController = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).ToLowerInvariant();
    var isLoggedIn = !string.IsNullOrWhiteSpace(Context.Session.GetString("Username"));
    var showCategoryNav = currentController != "auth";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SafeMed Pharmacy</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/storefront.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PharmacyPOS.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-authenticated="@isLoggedIn.ToString().ToLowerInvariant()"
      data-login-url="@Url.Action("Login", "Auth")">
    <div class="storefront-shell">
        <div class="storefront-utility-bar">
            <div class="storefront-container storefront-utility-inner">
                <span>Look Good. Do Good. Feel Great</span>
                <div class="storefront-utility-links">
                    <a href="#">Download the app</a>
                    <a href="#">Our Stores</a>
                    <a href="#">Store Locator</a>
                </div>
            </div>
        </div>

        <header class="storefront-header">
            <div class="storefront-container storefront-header-inner">
                <div class="storefront-search-wrap">
                    <button class="storefront-search-trigger" type="button" aria-label="Search">
                        <i class="bi bi-search"></i>
                    </button>
                    <div class="storefront-search-box">
                        <input type="search" placeholder="Search medicines, brands, and wellness essentials" />
                    </div>
                </div>

                <a class="storefront-logo" asp-controller="Home" asp-action="Index" aria-label="SafeMed home">
                    <img src="~/images/logo.png" alt="SafeMed Pharmacy" />
                </a>

                <div class="storefront-actions">
                    @if (isLoggedIn)
                    {
                        <a class="storefront-action-link" href="#">
                            <i class="bi bi-person"></i>
                            <span>@Context.Session.GetString("Username")</span>
                        </a>
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="storefront-inline-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="storefront-action-link storefront-action-button">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Logout</span>
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="storefront-login-menu">
                            <a class="storefront-action-link" asp-controller="Auth" asp-action="Login">
                                <i class="bi bi-person"></i>
                                <span>Login</span>
                            </a>
                            <div class="storefront-login-dropdown">
                                <a class="storefront-login-cta" asp-controller="Auth" asp-action="Register">
                                    <span>Create Account</span>
                                </a>
                                <a class="storefront-login-cta" asp-controller="Auth" asp-action="Login">
                                    <span>Login / Sign Up</span>
                                </a>
                                <div class="storefront-login-links">
                                    <a href="#"><i class="bi bi-person"></i><span>My Account</span></a>
                                    <a href="#"><i class="bi bi-heart"></i><span>Wish List</span></a>
                                    <a href="#"><i class="bi bi-box-seam"></i><span>My Orders</span></a>
                                </div>
                                <a class="storefront-login-chat" href="#">
                                    <i class="bi bi-chat-dots"></i>
                                    <span>Chat with Us</span>
                                </a>
                            </div>
                        </div>
                    }
                    <a class="storefront-action-link storefront-bag-link" asp-controller="Home" asp-action="Cart" data-cart-link>
                            <i class="bi bi-bag"></i>
                            <span>My CART</span>
                            <strong data-cart-count>0</strong>
                    </a>
                </div>
            </div>
        </header>

        @if (showCategoryNav)
        {
            <nav class="storefront-category-nav">
                <div class="storefront-container storefront-category-links">
                    <a class="storefront-category-link" asp-controller="Home" asp-action="Index">
                        <span>Our Products</span>
                        <i class="bi bi-chevron-down" aria-hidden="true"></i>
                    </a>
                    <a class="storefront-category-link" href="#">
                        <span>Medical Conditions</span>
                        <i class="bi bi-chevron-down" aria-hidden="true"></i>
                    </a>
                    <a class="storefront-category-link" href="#">
                        <span>Latest Promos</span>
                    </a>
                    <a class="storefront-category-link" href="#">
                        <span>About Us</span>
                        <i class="bi bi-chevron-down" aria-hidden="true"></i>
                    </a>
                </div>
            </nav>
        }

        <div class="storefront-page">
            <main class="storefront-container storefront-content-area">
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="cart-modal" data-cart-modal hidden>
        <div class="cart-modal__backdrop" data-cart-modal-close></div>
        <div class="cart-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="cart-modal-title">
            <div class="cart-modal__header">
                <h2 id="cart-modal-title">Product successfully added to your shopping cart</h2>
                <button type="button" class="cart-modal__close" aria-label="Close" data-cart-modal-close>
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="cart-modal__body">
                <div class="cart-modal__rx" data-cart-modal-rx hidden>
                    Reminder: This is an Rx product. You will be required to submit/upload your prescription upon checkout.
                </div>

                <div class="cart-modal__item">
                    <div class="cart-modal__image-wrap">
                        <img src="" alt="" data-cart-modal-image />
                        <p>Included taxes: <strong data-cart-modal-tax></strong></p>
                    </div>

                    <div class="cart-modal__details">
                        <div class="cart-modal__item-head">
                            <div>
                                <h3 data-cart-modal-name></h3>
                                <strong data-cart-modal-price></strong>
                            </div>
                            <span data-cart-modal-quantity></span>
                        </div>

                        <div class="cart-modal__actions">
                            <button type="button" class="cart-modal__action cart-modal__action--secondary" data-cart-modal-close>
                                Continue Shopping
                            </button>
                            <a class="cart-modal__action cart-modal__action--primary" asp-controller="Home" asp-action="Cart">
                                <i class="bi bi-check-circle"></i>
                                <span>Proceed to Checkout</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/cart.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
