@model PharmacyPOS.Models.Admin.AdminPaginationViewModel

@if (Model.TotalItems > 0)
{
    var pageSizeSelectId = $"{Model.Controller}-{Model.Action}-page-size".ToLowerInvariant();
    var routeValues = Model.RouteValues.ToDictionary(entry => entry.Key, entry => entry.Value);
    var visiblePages = Enumerable.Range(
        Math.Max(1, Model.CurrentPage - 2),
        Math.Min(Model.TotalPages, Model.CurrentPage + 2) - Math.Max(1, Model.CurrentPage - 2) + 1);

    <div class="admin-pagination">
        <div class="admin-pagination__summary">
            <strong>@Model.StartItem-@Model.EndItem</strong>
            <span>of @Model.TotalItems records</span>
        </div>

        <form method="get"
              asp-controller="@Model.Controller"
              asp-action="@Model.Action"
              class="admin-pagination__limit">
            @foreach (var route in Model.RouteValues)
            {
                <input type="hidden" name="@route.Key" value="@route.Value" />
            }
            <input type="hidden" name="page" value="1" />
            <label for="@pageSizeSelectId">Show</label>
            <select id="@pageSizeSelectId" name="pageSize" class="form-select form-select-sm" onchange="this.form.submit()">
                @foreach (var option in Model.PageSizeOptions)
                {
                    <option value="@option" selected="@(Model.PageSize == option)">@option</option>
                }
            </select>
        </form>

        <nav class="admin-pagination__nav" aria-label="Table pagination">
            @if (Model.HasPreviousPage)
            {
                <a asp-controller="@Model.Controller"
                   asp-action="@Model.Action"
                   asp-all-route-data="@routeValues"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   asp-route-pageSize="@Model.PageSize"
                   class="admin-pagination__button">
                    Previous
                </a>
            }
            else
            {
                <span class="admin-pagination__button admin-pagination__button--disabled">Previous</span>
            }

            @foreach (var pageNumber in visiblePages)
            {
                if (pageNumber == Model.CurrentPage)
                {
                    <span class="admin-pagination__page admin-pagination__page--active">@pageNumber</span>
                }
                else
                {
                    <a asp-controller="@Model.Controller"
                       asp-action="@Model.Action"
                       asp-all-route-data="@routeValues"
                       asp-route-page="@pageNumber"
                       asp-route-pageSize="@Model.PageSize"
                       class="admin-pagination__page">
                        @pageNumber
                    </a>
                }
            }

            @if (Model.HasNextPage)
            {
                <a asp-controller="@Model.Controller"
                   asp-action="@Model.Action"
                   asp-all-route-data="@routeValues"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   asp-route-pageSize="@Model.PageSize"
                   class="admin-pagination__button">
                    Next
                </a>
            }
            else
            {
                <span class="admin-pagination__button admin-pagination__button--disabled">Next</span>
            }
        </nav>
    </div>
}
