@{
    var currentController = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).ToLowerInvariant();
    var currentAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty).ToLowerInvariant();
    var username = Context.Session.GetString("Username") ?? "Admin";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SafeMed Pharmacy</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PharmacyPOS.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="pos-layout">
        <aside class="pos-sidebar">
            <div class="pos-brand">
                <div class="pos-logo">
                    <img src="~/images/logo.png" alt="SafeMed Logo" style="width: 100%; height: 100%; object-fit: contain;" />
                </div>
                <span>Admin POS Panel</span>
            </div>

            <nav class="pos-nav" aria-label="Admin navigation">
                <a class="pos-nav-link @(currentController == "dashboard" ? "active" : string.Empty)" asp-controller="Dashboard" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="Sales, revenue, orders, and stock overview">
                    <i class="bi bi-grid-1x2"></i> Dashboard
                </a>

                <p class="pos-nav-section">Applications</p>
                <a class="pos-nav-link @(currentController == "medicines" ? "active" : string.Empty)" asp-controller="Medicines" asp-action="Index" data-bs-toggle="tooltip" data-bs-placement="right" title="List, add, edit, and track medicine stock">
                    <i class="bi bi-capsule"></i> Medicine Inventory
                </a>
                <a class="pos-nav-link @(currentController == "modules" && currentAction == "pos" ? "active" : string.Empty)" asp-controller="Modules" asp-action="Pos" data-bs-toggle="tooltip" data-bs-placement="right" title="Fast counter checkout and transaction processing">
                    <i class="bi bi-cart3"></i> POS
                </a>
                <a class="pos-nav-link @(currentController == "modules" && currentAction == "payment" ? "active" : string.Empty)" asp-controller="Modules" asp-action="Payment" data-bs-toggle="tooltip" data-bs-placement="right" title="Track payment methods, status, and reconciliation">
                    <i class="bi bi-credit-card-2-front"></i> Payment
                </a>
                <a class="pos-nav-link @(currentController == "modules" && currentAction == "receipt" ? "active" : string.Empty)" asp-controller="Modules" asp-action="Receipt" data-bs-toggle="tooltip" data-bs-placement="right" title="Find, print, and download order receipts">
                    <i class="bi bi-receipt-cutoff"></i> Receipt
                </a>
                <a class="pos-nav-link @(currentController == "modules" && currentAction == "saleshistory" ? "active" : string.Empty)" asp-controller="Modules" asp-action="SalesHistory" data-bs-toggle="tooltip" data-bs-placement="right" title="Filter and review past transactions">
                    <i class="bi bi-graph-up-arrow"></i> Sales History
                </a>
                <a class="pos-nav-link @(currentController == "modules" && currentAction == "reports" ? "active" : string.Empty)" asp-controller="Modules" asp-action="Reports" data-bs-toggle="tooltip" data-bs-placement="right" title="Sales, revenue, and inventory analytics">
                    <i class="bi bi-bar-chart-line"></i> Reports
                </a>
                <a class="pos-nav-link @(currentController == "modules" && currentAction == "stockalerts" ? "active" : string.Empty)" asp-controller="Modules" asp-action="StockAlerts" data-bs-toggle="tooltip" data-bs-placement="right" title="Low stock and expiring medicine queue">
                    <i class="bi bi-exclamation-triangle"></i> Stock Alerts
                </a>
                <a class="pos-nav-link @(currentController == "modules" && currentAction == "storefront" ? "active" : string.Empty)" asp-controller="Modules" asp-action="Storefront" data-bs-toggle="tooltip" data-bs-placement="right" title="Manage customer-facing product availability">
                    <i class="bi bi-shop-window"></i> Storefront
                </a>

                <p class="pos-nav-section">Access</p>
                <a class="pos-nav-link @(currentController == "modules" && currentAction == "adminusers" ? "active" : string.Empty)" asp-controller="Modules" asp-action="AdminUsers" data-bs-toggle="tooltip" data-bs-placement="right" title="Manage admin roles and account activity">
                    <i class="bi bi-person-gear"></i> Admin User
                </a>
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="pos-nav-link pos-nav-button" data-bs-toggle="tooltip" data-bs-placement="right" title="End the current admin session">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                </form>
            </nav>

            <div class="pos-user-footer">
                <div class="pos-user-footer__avatar"><i class="bi bi-person-badge"></i></div>
                <div>
                    <strong>@username</strong>
                    <span>Administrator</span>
                </div>
            </div>
        </aside>

        <main class="pos-main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach((element) => {
            new bootstrap.Tooltip(element);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
