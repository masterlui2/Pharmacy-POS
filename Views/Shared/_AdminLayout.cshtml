@using PharmacyPOS.Models.Navigation
@using PharmacyPOS.Models.Security
@using PharmacyPOS.Helpers
@{
    var currentController = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).ToLowerInvariant();
    var currentAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty).ToLowerInvariant();
    var username = Context.Session.GetString("Username") ?? "Staff";
    var role = Context.Session.GetString("Role") ?? string.Empty;
    var portalTitle = BackOfficeNavigation.GetPortalTitle(role);
    var roleLabel = BackOfficeNavigation.GetRoleLabel(role);
    var navigationItems = BackOfficeNavigation.GetItemsForRole(role);
    var groupedNavigation = navigationItems
        .GroupBy(item => item.Section)
        .ToList();

    bool IsActive(SidebarNavigationItem item) =>
        string.Equals(currentController, item.Controller, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(currentAction, item.Action, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SafeMed Pharmacy</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PharmacyPOS.styles.css" asp-append-version="true" />
</head>
<body class="admin-shell-body">
    <div class="pos-layout">
        <aside class="pos-sidebar" id="admin-sidebar" data-admin-sidebar>
            <div class="pos-brand">
                <div class="pos-brand__top">
                    <div class="pos-logo">
                        <img src="~/images/logo.png" alt="SafeMed Logo" />
                    </div>
                    <button type="button" class="pos-sidebar-close" data-admin-sidebar-close aria-label="Close navigation">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <span>@portalTitle</span>
            </div>

            <nav class="pos-nav" aria-label="Back-office navigation">
                @foreach (var navGroup in groupedNavigation)
                {
                    <p class="pos-nav-section">@navGroup.Key</p>
                    @foreach (var item in navGroup)
                    {
                        <a class="pos-nav-link @(IsActive(item) ? "active" : string.Empty)"
                           asp-controller="@item.Controller"
                           asp-action="@item.Action"
                           data-bs-toggle="tooltip"
                           data-bs-placement="right"
                           title="@item.Tooltip">
                            <i class="bi @item.Icon"></i> @item.Label
                        </a>
                    }
                }

                <p class="pos-nav-section">Session</p>
                @if (AppRoles.Matches(role, AppRoles.Pharmacist))
                {
                    <a class="pos-nav-link @(currentController == "home" ? "active" : string.Empty)"
                       asp-controller="Home"
                       asp-action="Index"
                       data-bs-toggle="tooltip"
                       data-bs-placement="right"
                       title="Open the customer storefront">
                        <i class="bi bi-shop-window"></i> Storefront
                    </a>
                }
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="pos-nav-link pos-nav-button" data-bs-toggle="tooltip" data-bs-placement="right" title="End the current session">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                </form>
            </nav>

            <div class="pos-user-footer">
                <div class="pos-user-footer__avatar">
                    <i class="bi @(AppRoles.Matches(role, AppRoles.Admin) ? "bi-person-badge" : "bi-capsule-pill")"></i>
                </div>
                <div>
                    <strong>@username</strong>
                    <span class="@AdminViewHelper.RoleClass(role)">@roleLabel</span>
                </div>
            </div>
        </aside>

        <div class="pos-sidebar-backdrop" data-admin-sidebar-close></div>

        <div class="pos-content-shell">
            <header class="pos-mobile-bar">
                <button type="button"
                        class="pos-mobile-toggle"
                        data-admin-sidebar-toggle
                        aria-controls="admin-sidebar"
                        aria-expanded="false"
                        aria-label="Open navigation">
                    <i class="bi bi-list"></i>
                </button>
                <div class="pos-mobile-brand">
                    <img src="~/images/logo.png" alt="SafeMed Logo" />
                    <div>
                        <strong>@portalTitle</strong>
                        <span>@username</span>
                    </div>
                </div>
            </header>

            <main class="pos-main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin/layout.js" asp-append-version="true"></script>
    <script src="~/js/admin/modules.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
