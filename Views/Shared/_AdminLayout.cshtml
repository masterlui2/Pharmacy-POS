@{
    var currentController = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).ToLowerInvariant();
    var currentAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty).ToLowerInvariant();
    var username = Context.Session.GetString("Username") ?? "Admin";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SafeMed Pharmacy</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PharmacyPOS.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="pos-layout">
        <aside class="pos-sidebar">
            <div class="pos-brand">
                <div class="pos-logo">
                    <img src="~/images/logo.png" alt="SafeMed Logo" style="width: 100%; height: 100%; object-fit: contain;" />
                </div>
                <span>Admin POS Panel</span>
            </div>

            <nav class="pos-nav">
                <a class="pos-nav-link @(currentController == "dashboard" ? "active" : string.Empty)" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i> Dashboard
                </a>

                <p class="pos-nav-section">Applications</p>
                <a class="pos-nav-link @(currentController == "medicines" ? "active" : string.Empty)" asp-controller="Medicines" asp-action="Index">
                    <i class="bi bi-capsule"></i> Medicine Inventory
                </a>
                <a class="pos-nav-link @(currentController == "modules" && currentAction == "pos" ? "active" : string.Empty)" asp-controller="Modules" asp-action="Pos">
                    <i class="bi bi-cart3"></i> POS / Sales
                </a>
                <a class="pos-nav-link @(currentController == "modules" && currentAction == "payment" ? "active" : string.Empty)" asp-controller="Modules" asp-action="Payment">
                    <i class="bi bi-credit-card"></i> Payment
                </a>
                <a class="pos-nav-link @(currentController == "modules" && currentAction == "receipt" ? "active" : string.Empty)" asp-controller="Modules" asp-action="Receipt">
                    <i class="bi bi-receipt"></i> Receipt
                </a>
                <a class="pos-nav-link @(currentController == "modules" && currentAction == "saleshistory" ? "active" : string.Empty)" asp-controller="Modules" asp-action="SalesHistory">
                    <i class="bi bi-graph-up-arrow"></i> Sales History
                </a>
                <a class="pos-nav-link @(currentController == "modules" && currentAction == "reports" ? "active" : string.Empty)" asp-controller="Modules" asp-action="Reports">
                    <i class="bi bi-file-earmark-text"></i> Reports
                </a>
                <a class="pos-nav-link @(currentController == "modules" && currentAction == "stockalerts" ? "active" : string.Empty)" asp-controller="Modules" asp-action="StockAlerts">
                    <i class="bi bi-exclamation-triangle"></i> Stock Alerts
                </a>

                <p class="pos-nav-section">Access</p>
                <a class="pos-nav-link" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shop"></i> Storefront
                </a>
                <div class="pos-nav-link" style="cursor: default; margin-top: auto;">
                    <i class="bi bi-person-circle"></i> @username
                </div>
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="pos-nav-link" style="width: 100%; border: 0; background: transparent; text-align: left;">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                </form>
            </nav>
        </aside>

        <main class="pos-main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
