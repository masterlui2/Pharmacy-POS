@model PharmacyPOS.Models.Medicine
@{
    ViewData["Title"] = "Medicine Details";
}

<section class="admin-module-hero">
    <div>
        <p class="admin-module-hero__eyebrow">Inventory module</p>
        <h2>Medicine Details</h2>
        <p>Review the complete product record before updating stock, pricing, or storefront availability.</p>
    </div>
    <div class="admin-module-hero__actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-danger admin-hero-action">
            <i class="bi bi-pencil-square"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-danger admin-hero-action">
            <i class="bi bi-list-ul"></i> Back to List
        </a>
    </div>
</section>

<nav class="admin-workflow-strip" aria-label="Inventory details workflow">
    <span><i class="bi bi-list-ul"></i> List View</span>
    <span><i class="bi bi-plus-circle"></i> Create/Add</span>
    <span><i class="bi bi-pencil-square"></i> Edit</span>
    <span class="active"><i class="bi bi-eye"></i> View Details</span>
    <span><i class="bi bi-lightning-charge"></i> Actions</span>
</nav>

<section class="admin-panel">
    <div class="admin-panel__header">
        <div>
            <h4>@Model.BrandName</h4>
            <p>@Model.GenericName</p>
        </div>
        <span class="@StatusClass(Model.Status)">@Model.Status</span>
    </div>

    <dl class="admin-detail-grid">
        <div><dt>Code</dt><dd>@Model.Code</dd></div>
        <div><dt>Brand Name</dt><dd>@Model.BrandName</dd></div>
        <div><dt>Generic Name</dt><dd>@Model.GenericName</dd></div>
        <div><dt>Category</dt><dd>@Model.Category</dd></div>
        <div><dt>Supplier</dt><dd>@Model.Supplier</dd></div>
        <div><dt>Price</dt><dd>@Model.Price.ToString("C")</dd></div>
        <div><dt>Stock</dt><dd>@Model.Stock</dd></div>
        <div><dt>Prescription</dt><dd>@(Model.RequiresPrescription ? "Required" : "Not required")</dd></div>
        <div><dt>Expiry Date</dt><dd>@Model.ExpiryDate.ToString("yyyy-MM-dd")</dd></div>
    </dl>
</section>

@functions {
    private static string StatusClass(string value)
    {
        return value switch
        {
            "In Stock" => "admin-badge admin-badge--success",
            "Low Stock" => "admin-badge admin-badge--warning",
            "Out of Stock" => "admin-badge admin-badge--danger",
            _ => "admin-badge"
        };
    }
}
