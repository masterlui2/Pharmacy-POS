@model PharmacyPOS.Models.Medicine
@{
    ViewData["Title"] = "Edit Medicine";
}

<section class="admin-module-hero">
    <div>
        <p class="admin-module-hero__eyebrow">Inventory module</p>
        <h2>Edit Medicine</h2>
        <p>Update product, supplier, price, stock, or expiry information.</p>
    </div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-danger admin-hero-action">
        <i class="bi bi-eye"></i> View Details
    </a>
</section>

<nav class="admin-workflow-strip" aria-label="Inventory edit workflow">
    <span><i class="bi bi-list-ul"></i> List View</span>
    <span><i class="bi bi-plus-circle"></i> Create/Add</span>
    <span class="active"><i class="bi bi-pencil-square"></i> Edit</span>
    <span><i class="bi bi-eye"></i> View Details</span>
    <span><i class="bi bi-lightning-charge"></i> Actions</span>
</nav>

<section class="admin-panel">
    <div class="admin-panel__header">
        <div>
            <h4>@Model.BrandName</h4>
            <p>@Model.Code · @Model.GenericName</p>
        </div>
    </div>
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <partial name="_Form" model="Model" />

        <div class="admin-form-actions">
            <button class="btn btn-danger" type="submit"><i class="bi bi-save"></i> Update Medicine</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
