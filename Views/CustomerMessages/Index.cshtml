@model PharmacyPOS.Models.Messages.CustomerMessagesViewModel
@{
    ViewData["Title"] = "Messages";
}

@section Styles {
    <link rel="stylesheet" href="~/css/customer-messages.css" asp-append-version="true" />
}

<section class="customer-chat-page">
    <header class="customer-chat-page__header">
        <div>
            <p class="customer-chat-page__eyebrow">Customer Support</p>
            <h1>Messages</h1>
            <p>Talk directly with the pharmacist about an order, prescription check, or delivery update.</p>
        </div>
    </header>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="customer-chat-banner customer-chat-banner--success">
            <i class="bi bi-check-circle-fill"></i>
            <div>
                <strong>Message sent.</strong>
                <span>@successMessage</span>
            </div>
        </div>
    }

    @if (TempData["Error"] is string errorMessage)
    {
        <div class="customer-chat-banner customer-chat-banner--danger">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                <strong>Unable to send message.</strong>
                <span>@errorMessage</span>
            </div>
        </div>
    }

    <div class="customer-chat-shell">
        <aside class="customer-chat-sidebar">
            <header class="customer-chat-sidebar__header">
                <p class="customer-chat-page__eyebrow">Your Orders</p>
                <h2>Conversations</h2>
                <span>@Model.UnreadCount unread repl@(Model.UnreadCount == 1 ? "y" : "ies")</span>
            </header>

            <div class="customer-chat-thread-list">
                @if (!Model.HasOrders)
                {
                    <div class="customer-chat-sidebar__empty">
                        <i class="bi bi-bag-x"></i>
                        <p>No orders yet. Place an order first to open a pharmacist chat thread.</p>
                    </div>
                }
                else
                {
                    @foreach (var thread in Model.OrderThreads)
                    {
                        var preview = string.IsNullOrWhiteSpace(thread.LastMessagePreview)
                            ? thread.ItemSummary
                            : thread.LastMessagePreview;

                        <a class="customer-chat-thread @(thread.OrderNumber == Model.SelectedOrderNumber ? "customer-chat-thread--active" : string.Empty)"
                           asp-action="Index"
                           asp-route-orderNumber="@thread.OrderNumber">
                            <div class="customer-chat-thread__avatar">
                                <i class="bi bi-box-seam"></i>
                            </div>
                            <div class="customer-chat-thread__body">
                                <div class="customer-chat-thread__topline">
                                    <strong>@thread.OrderNumber</strong>
                                    <span>@thread.UpdatedAtUtc.ToLocalTime().ToString("MMM dd")</span>
                                </div>
                                <p>@preview</p>
                                <div class="customer-chat-thread__meta">
                                    <small>@thread.ItemsCount item@(thread.ItemsCount == 1 ? string.Empty : "s")</small>
                                    <small>@thread.OrderStatus</small>
                                    <small>@thread.PaymentStatus</small>
                                </div>
                            </div>
                            @if (thread.UnreadCount > 0)
                            {
                                <span class="customer-chat-thread__badge">@thread.UnreadCount</span>
                            }
                        </a>
                    }
                }
            </div>

            <div class="customer-chat-sidebar__note">
                <i class="bi bi-shield-check"></i>
                <p>Each chat is linked to one order so the pharmacist can see exactly what you bought.</p>
            </div>
        </aside>

        <section class="customer-chat-panel">
            @if (Model.ActiveThread is null)
            {
                <div class="customer-chat-empty customer-chat-empty--panel">
                    <i class="bi bi-chat-dots"></i>
                    <h3>No order selected</h3>
                    <p>Select an order from the left to open its pharmacist chat.</p>
                </div>
            }
            else
            {
                <header class="customer-chat-panel__header">
                    <div class="customer-chat-panel__identity">
                        <div class="customer-chat-thread__avatar customer-chat-thread__avatar--large">
                            <i class="bi bi-chat-heart"></i>
                        </div>
                        <div>
                            <h2>@Model.SupportName</h2>
                            <p>@Model.SupportSubtitle</p>
                        </div>
                    </div>
                    <div class="customer-chat-panel__context">
                        <span class="customer-chat-chip customer-chat-chip--strong">@Model.ActiveThread.OrderNumber</span>
                        <span class="customer-chat-chip">Ref @Model.ActiveThread.OrderReference</span>
                    </div>
                </header>

                <section class="customer-chat-order-summary">
                    <div class="customer-chat-order-summary__meta">
                        <strong>@Model.ActiveThread.ItemSummary</strong>
                        <span>@Model.ActiveThread.ItemsCount item@(Model.ActiveThread.ItemsCount == 1 ? string.Empty : "s") | PHP @Model.ActiveThread.TotalAmount.ToString("N2")</span>
                    </div>
                    <div class="customer-chat-order-summary__badges">
                        <span>@Model.ActiveThread.OrderStatus</span>
                        <span>@Model.ActiveThread.PaymentStatus</span>
                        @if (Model.ActiveThread.RequiresPrescription)
                        {
                            <span>Rx: @Model.ActiveThread.PrescriptionStatus</span>
                        }
                    </div>
                    <div class="customer-chat-order-items">
                        @foreach (var item in Model.ActiveThread.Items)
                        {
                            <span>@item.ProductName x@item.Quantity</span>
                        }
                    </div>
                </section>

                <div class="customer-chat-scroll">
                    @if (Model.ActiveThread.Messages.Count == 0)
                    {
                        <div class="customer-chat-empty">
                            <i class="bi bi-chat-dots"></i>
                            <h3>No messages yet</h3>
                            <p>Send your first message for this order and the pharmacist will reply here.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var message in Model.ActiveThread.Messages)
                        {
                            <article class="customer-chat-bubble @(message.IsCustomerMessage ? "customer-chat-bubble--self" : string.Empty)">
                                @if (!message.IsCustomerMessage)
                                {
                                    <header>
                                        <strong>@message.SenderName</strong>
                                    </header>
                                }
                                <p>@message.Body</p>
                                <small>
                                    @(message.IsCustomerMessage ? "You" : message.SenderRole) | @message.SentAtUtc.ToLocalTime().ToString("MMM dd, hh:mm tt")
                                </small>
                            </article>
                        }
                    }
                </div>

                <form method="post" asp-action="Send" class="customer-chat-composer">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="OrderNumber" value="@Model.ActiveThread.OrderNumber" />
                    <div class="customer-chat-composer__field">
                        <label for="messageBody" class="visually-hidden">Message</label>
                        <textarea id="messageBody" name="Body" rows="2" placeholder="Write a message about this order..." required></textarea>
                        <button type="submit" class="customer-chat-send">
                            <i class="bi bi-send-fill"></i>
                            <span>Send</span>
                        </button>
                    </div>
                    <div class="customer-chat-composer__row">
                        <span>Linked to order @Model.ActiveThread.OrderNumber.</span>
                        <span>Replies from the pharmacist will appear here.</span>
                    </div>
                </form>
            }
        </section>
    </div>
</section>
