@model PharmacyPOS.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .storefront-page {
        padding-top: 1.5rem;
    }

    .login-wrapper {
        min-height: calc(100vh - 220px);
    }

    .login-card {
        width: 100%;
        max-width: 500px;
        border: none;
        border-radius: 24px;
        box-shadow: 0 18px 40px rgba(17, 24, 39, 0.08);
        padding: 2.5rem 2.25rem;
        background: #fff;
    }

    .login-brand-mark {
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .login-brand-mark img {
        width: 240px;
        max-width: 100%;
        height: auto;
        display: block;
        margin: 0 auto 0.75rem;
    }

    .login-title {
        font-size: 1.9rem;
        font-weight: 700;
        color: #212529;
        margin-bottom: 0.35rem;
    }

    .login-subtitle {
        color: #6b7280;
        font-size: 0.95rem;
        margin-bottom: 0;
    }

    .login-home-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: #a30d17;
        text-decoration: none;
        font-weight: 600;
        margin-bottom: 1.5rem;
    }

    .login-account-panel {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        background: #f8fafc;
        padding: 1rem 1.1rem;
        margin-bottom: 1.6rem;
    }

    .login-account-copy strong {
        display: block;
        color: #1f2937;
        font-size: 0.98rem;
        margin-bottom: 0.2rem;
    }

    .login-account-copy span {
        color: #64748b;
        font-size: 0.88rem;
    }

    .login-account-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 148px;
        height: 42px;
        padding: 0 1rem;
        border-radius: 999px;
        background: #991b1b;
        color: #fff;
        text-decoration: none;
        font-size: 0.86rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .form-label {
        font-size: 0.95rem;
        color: #6b7280;
        margin-bottom: 0.4rem;
    }

    .form-control {
        border: none;
        border-bottom: 1px solid #ced4da;
        border-radius: 0;
        padding-left: 0;
        padding-right: 0;
        box-shadow: none !important;
        background-color: transparent;
    }

    .form-control:focus {
        border-bottom: 2px solid #c8102e;
        background-color: transparent;
    }

    .input-group-text {
        border: none;
        border-bottom: 1px solid #ced4da;
        border-radius: 0;
        background: transparent;
        color: #9aa0a6;
        padding-right: 0;
    }

    .input-group .form-control:focus + .input-group-text,
    .input-group .input-group-text:has(+ .form-control:focus) {
        border-bottom: 2px solid #c8102e;
    }

    .login-btn {
        border: none;
        border-radius: 30px;
        padding: 0.85rem 1rem;
        font-weight: 600;
        color: white;
        background: linear-gradient(90deg, #c8102e, #9f0f20);
        box-shadow: 0 10px 22px rgba(200, 16, 46, 0.24);
        transition: 0.2s ease-in-out;
    }

    .login-btn:hover {
        color: white;
        transform: translateY(-1px);
        opacity: 0.96;
    }

    .password-toggle-btn {
        border: none;
        border-bottom: 1px solid #ced4da;
        background: transparent;
        color: #9aa0a6;
        padding: 0 0.75rem;
    }

    .password-toggle-btn:focus {
        outline: none;
        box-shadow: none;
    }
</style>

<div class="container">
    <div class="row justify-content-center align-items-center login-wrapper">
        <div class="col-12 d-flex justify-content-center">
            <div class="login-card">
 <a class="login-home-link" asp-controller="Dashboard" asp-action="Index">                    <i class="bi bi-arrow-left"></i>
                    <span>Back to homepage</span>
                </a>

                <div class="login-brand-mark">
                    <img src="~/images/logo.png" alt="SafeMed Pharmacy" />
                    <h1 class="login-title">Welcome back</h1>
                    <p class="login-subtitle">Sign in to manage medicines, sales, and pharmacy operations.</p>
                </div>

                <div class="login-account-panel">
                    <div class="login-account-copy">
                        <strong>Create an account first</strong>
                        <span>Static placeholder for new customer registration and profile setup.</span>
                    </div>
                    <a class="login-account-link" href="#">Create Account</a>
                </div>

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger rounded-3" role="alert">
                        @ViewBag.ErrorMessage
                    </div>
                }

                <form asp-action="Login" asp-controller="Auth" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Username" class="form-label">Email</label>
                        <input asp-for="Username" class="form-control" placeholder="johndoe@example.com" autocomplete="username" />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label">Password</label>
                        <div class="input-group">
                            <input asp-for="Password" class="form-control" id="passwordInput" placeholder="Enter password" autocomplete="current-password" />
                            <button class="password-toggle-btn" type="button" onclick="togglePassword()" tabindex="-1">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="login-btn">
                            LOGIN
                        </button>
                    </div>
                </form>

           
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function togglePassword() {
            const passwordInput = document.getElementById("passwordInput");
            const icon = document.querySelector(".password-toggle-btn i");

            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            } else {
                passwordInput.type = "password";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }
        }
    </script>
}
