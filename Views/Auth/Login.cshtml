@model PharmacyPOS.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth/forms.css" asp-append-version="true" />
}

<section class="auth-shell">
    <div class="auth-card auth-card--compact">
        <a class="auth-back-link" asp-controller="Home" asp-action="Index">
            <i class="bi bi-arrow-left"></i>
            <span>Back to homepage</span>
        </a>

        <div class="auth-brand">
            <img src="~/images/logo.png" alt="SafeMed Pharmacy" />
            <h1>Welcome back</h1>
            <p>Sign in to continue shopping, manage prescription orders, and track your basket.</p>
        </div>

        @if (TempData["AuthSuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success rounded-4" role="alert">
                @successMessage
            </div>
        }

        <div class="auth-switch-panel">
            <div>
                <strong>Need an account first?</strong>
                <span>Create a customer account to save your cart and process Rx orders.</span>
            </div>
            <a class="auth-switch-link" asp-controller="Auth" asp-action="Register">Create Account</a>
        </div>

        <form asp-action="Login" asp-controller="Auth" method="post" class="auth-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="auth-field">
                <label asp-for="Username"></label>
                <input asp-for="Username" placeholder="Email or username" autocomplete="username" />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Password"></label>
                <div class="auth-password-wrap">
                    <input asp-for="Password" placeholder="Enter password" autocomplete="current-password" data-password-input />
                    <button type="button" class="auth-password-toggle" data-password-toggle aria-label="Toggle password visibility">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="auth-submit">Login</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
