@model PharmacyPOS.Models.RegisterViewModel

@{
    ViewData["Title"] = "Create Account";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var recaptchaSiteKey = ViewBag.RecaptchaSiteKey as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth/forms.css" asp-append-version="true" />
}

<section class="auth-shell">
    <div class="auth-card auth-card--register">
        <div class="auth-register-head">
            <h1>Create an account</h1>
            <p>Already have an account? <a asp-controller="Auth" asp-action="Login">Log in instead!</a></p>
        </div>

        <form asp-action="Register" asp-controller="Auth" method="post" class="auth-form auth-form--register">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="auth-form__section">
                <h2>Personal Information</h2>
            </div>

            <div class="auth-form__row">
                <label asp-for="FirstName"></label>
                <div class="auth-form__control">
                    <input asp-for="FirstName" placeholder="First name" autocomplete="given-name" />
                    <p>Only letters and the dot (.) character, followed by a space, are allowed.</p>
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
            </div>

            <div class="auth-form__row">
                <label asp-for="LastName"></label>
                <div class="auth-form__control">
                    <input asp-for="LastName" placeholder="Last name" autocomplete="family-name" />
                    <p>Only letters and the dot (.) character, followed by a space, are allowed.</p>
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
            </div>

            <div class="auth-form__row">
                <label asp-for="Email"></label>
                <div class="auth-form__control">
                    <input asp-for="Email" placeholder="Email" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
            </div>

            <div class="auth-form__row">
                <label asp-for="PhoneNumber"></label>
                <div class="auth-form__control">
                    <input asp-for="PhoneNumber" placeholder="Phone number" autocomplete="tel" inputmode="tel" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>
            </div>

            <div class="auth-form__row">
                <label asp-for="Password"></label>
                <div class="auth-form__control">
                    <div class="auth-password-wrap auth-password-wrap--guided">
                        <input asp-for="Password" placeholder="Password" autocomplete="new-password" data-password-input />
                        <button type="button" class="auth-password-toggle" data-password-toggle aria-label="Toggle password visibility">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <div class="auth-password-guide" data-password-guide hidden>
                        <p>Password must meet the following requirements:</p>
                        <ul class="auth-password-rules">
                            <li data-password-rule="letter"><i class="bi bi-exclamation-diamond-fill"></i><span>At least one letter</span></li>
                            <li data-password-rule="uppercase"><i class="bi bi-exclamation-diamond-fill"></i><span>At least one capital letter</span></li>
                            <li data-password-rule="number"><i class="bi bi-exclamation-diamond-fill"></i><span>At least one number</span></li>
                            <li data-password-rule="special"><i class="bi bi-exclamation-diamond-fill"></i><span>At least one special character</span></li>
                            <li data-password-rule="length"><i class="bi bi-exclamation-diamond-fill"></i><span>Be at least 6 characters</span></li>
                        </ul>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
            </div>

            <div class="auth-form__row">
                <label asp-for="ConfirmPassword"></label>
                <div class="auth-form__control">
                    <div class="auth-password-wrap">
                        <input asp-for="ConfirmPassword" placeholder="Confirm Password" autocomplete="new-password" data-password-input />
                        <button type="button" class="auth-password-toggle" data-password-toggle aria-label="Toggle password visibility">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <div class="auth-consent-list">
                <div class="auth-recaptcha">
                    <div class="g-recaptcha" data-sitekey="@recaptchaSiteKey"></div>
                    <input asp-for="RecaptchaToken" type="hidden" />
                    <span asp-validation-for="RecaptchaToken" class="text-danger small"></span>
                </div>

                <label class="auth-consent">
                    <input asp-for="AcceptTerms" data-consent-checkbox />
                    <span>I agree to the <strong>Terms and Conditions.</strong></span>
                </label>
                <span asp-validation-for="AcceptTerms" class="text-danger small" data-consent-validation="AcceptTerms"></span>

                <label class="auth-consent">
                    <input asp-for="AcceptPrivacyPolicy" data-consent-checkbox />
                    <span>I agree and give my explicit consent to the collection, use, processing, and sharing of my personal information in accordance to the <strong>Data Privacy Policy</strong> of TGP.</span>
                </label>
                <span asp-validation-for="AcceptPrivacyPolicy" class="text-danger small" data-consent-validation="AcceptPrivacyPolicy"></span>
            </div>

            <div class="auth-actions">
                <button type="submit" class="auth-submit">Create Account</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var form = document.querySelector(".auth-form--register");
            var tokenInput = document.getElementById("RecaptchaToken");

            if (!form || !tokenInput) {
                return;
            }

            form.addEventListener("submit", function () {
                var response = window.grecaptcha && typeof window.grecaptcha.getResponse === "function"
                    ? window.grecaptcha.getResponse()
                    : "";

                tokenInput.value = response;
            });
        });
    </script>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
