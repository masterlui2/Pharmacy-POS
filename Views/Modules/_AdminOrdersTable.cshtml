@model IReadOnlyList<PharmacyPOS.Models.Admin.AdminSalesOrderRowViewModel>
@using PharmacyPOS.Helpers

<div class="admin-table-shell">
    <table class="admin-table admin-table--responsive">
        <thead>
            <tr>
                <th>Order</th>
                <th>Customer</th>
                <th>Method</th>
                <th>Payment</th>
                <th>Status</th>
                <th>Items</th>
                <th>Total</th>
                <th>Created</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="8" class="admin-table__empty">No sales records found.</td></tr>
            }
            else
            {
                @foreach (var order in Model)
                {
                    <tr>
                        <td data-label="Order"><strong>@order.OrderNumber</strong></td>
                        <td data-label="Customer">@order.CustomerName</td>
                        <td data-label="Method">@AdminViewHelper.PaymentMethodLabel(order.PaymentMethod)</td>
                        <td data-label="Payment"><span class="@AdminViewHelper.StatusClass(order.PaymentStatus)">@order.PaymentStatus</span></td>
                        <td data-label="Status"><span class="@AdminViewHelper.StatusClass(order.OrderStatus)">@order.OrderStatus</span></td>
                        <td data-label="Items">@order.ItemsCount</td>
                        <td data-label="Total">PHP @order.TotalAmount.ToString("N2")</td>
                        <td data-label="Created">@order.CreatedAtUtc.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
