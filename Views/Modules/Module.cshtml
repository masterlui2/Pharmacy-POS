                        }
                    });

                    if (!response.ok) {
                        throw new Error("Prescription preview failed.");
                    }

                    previewContent.innerHTML = await response.text();
                } catch {
                    previewContent.innerHTML = "<div class=\"admin-empty-state\">Prescription preview could not be loaded.</div>";
                }
