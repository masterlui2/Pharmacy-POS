@model PharmacyPOS.Models.Admin.AdminModuleViewModel
@using PharmacyPOS.Helpers
@{
    var pageSize = Model.Pagination?.PageSize ?? 10;
    var alertFilters = new[] { "Low Stock", "Out of Stock", "Expiring Soon" };
}

<section class="admin-panel">
    <div class="admin-panel__header">
        <div>
            <h4>Alert Queue</h4>
            <p>Actionable stock issues with supplier context, expiry timing, and quick replenishment tools.</p>
        </div>
    </div>

    <form method="get" class="admin-filter-grid admin-filter-grid--three">
        <input name="search" value="@Model.Search" class="form-control" placeholder="Search code, product, supplier" />
        <select class="form-select" name="status">
            <option value="">All alerts</option>
            @foreach (var filter in alertFilters)
            {
                <option value="@filter" selected="@(Model.StatusFilter == filter)">@filter</option>
            }
        </select>
        <input type="hidden" name="page" value="1" />
        <input type="hidden" name="pageSize" value="@pageSize" />
        <button class="btn btn-danger" type="submit"><i class="bi bi-funnel"></i> Filter</button>
    </form>

    <div class="admin-table-shell">
        <table class="admin-table admin-table--responsive">
            <thead>
                <tr>
                    <th>Alert</th>
                    <th>Medicine</th>
                    <th>Supplier</th>
                    <th>Stock Status</th>
                    <th>Expiry Window</th>
                    <th>Restock</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.InventoryAlerts.Count == 0)
                {
                    <tr><td colspan="6" class="admin-table__empty">No stock alerts matched the current filters.</td></tr>
                }
                else
                {
                    @foreach (var alert in Model.InventoryAlerts)
                    {
                        var daysToExpiry = alert.DaysUntilExpiry;
                        var expiryClass = daysToExpiry < 0
                            ? "admin-badge admin-badge--danger"
                            : daysToExpiry <= 60
                                ? "admin-badge admin-badge--warning"
                                : "admin-badge admin-badge--success";
                        var expiryLabel = daysToExpiry < 0
                            ? $"Expired {Math.Abs(daysToExpiry)} day{(Math.Abs(daysToExpiry) == 1 ? string.Empty : "s")} ago"
                            : daysToExpiry == 0
                                ? "Expires today"
                                : $"{daysToExpiry} day{(daysToExpiry == 1 ? string.Empty : "s")} remaining";

                        <tr>
                            <td data-label="Alert"><span class="@AdminViewHelper.StatusClass(alert.Reason)">@alert.Reason</span></td>
                            <td data-label="Medicine">
                                <strong>@alert.BrandName</strong>
                                <span>@alert.Code | @alert.GenericName</span>
                            </td>
                            <td data-label="Supplier">
                                <strong>@alert.Supplier</strong>
                                <span>@alert.Category</span>
                            </td>
                            <td data-label="Stock Status">
                                <strong class="admin-number">@alert.Stock unit@(alert.Stock == 1 ? string.Empty : "s")</strong>
                                <span class="@AdminViewHelper.StatusClass(alert.Status)">@alert.Status</span>
                            </td>
                            <td data-label="Expiry Window">
                                <strong>@alert.ExpiryDate.ToString("yyyy-MM-dd")</strong>
                                <span class="@expiryClass">@expiryLabel</span>
                            </td>
                            <td data-label="Restock">
                                <form asp-action="Restock" method="post" class="admin-inline-form admin-inline-form--compact">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="MedicineId" value="@alert.MedicineId" />
                                    <input class="form-control" name="Quantity" type="number" min="1" value="10" aria-label="Restock quantity" />
                                    <button class="btn btn-outline-danger" type="submit" data-bs-toggle="tooltip" title="Add stock">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.Pagination is not null)
    {
        <partial name="~/Views/Shared/_AdminPagination.cshtml" model="Model.Pagination" />
    }
</section>
