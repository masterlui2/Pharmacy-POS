@model PharmacyPOS.Models.Admin.AdminModuleViewModel
@using PharmacyPOS.Helpers
@{
    var pageSize = Model.Pagination?.PageSize ?? 10;
    var paymentMethods = new[] { "Cash", "CashOnDelivery", "GCash", "PayMaya", "Card" };
    var paymentStatuses = new[] { "Paid", "Unpaid" };
    var updateStatuses = new[] { "AwaitingPayment", "RedirectedToGateway", "PendingCollection", "Paid", "Failed", "Refunded" };
}

<section class="admin-panel">
    <div class="admin-panel__header">
        <div>
            <h4>Payment Tracking</h4>
            <p>Review all payment methods, including cash on delivery, with clear paid and unpaid status.</p>
        </div>
    </div>

    <form method="get" class="admin-filter-grid admin-filter-grid--payment">
        <input name="search" value="@Model.Search" class="form-control" placeholder="Search reference, order, customer" />
        <select class="form-select" name="method">
            <option value="">All methods</option>
            @foreach (var method in paymentMethods)
            {
                <option value="@method" selected="@(Model.PaymentFilter == method)">@AdminViewHelper.PaymentMethodLabel(method)</option>
            }
        </select>
        <select class="form-select" name="status">
            <option value="">All statuses</option>
            @foreach (var status in paymentStatuses)
            {
                <option value="@status" selected="@(Model.StatusFilter == status)">@status</option>
            }
        </select>
        <input type="hidden" name="page" value="1" />
        <input type="hidden" name="pageSize" value="@pageSize" />
        <button class="btn btn-danger" type="submit"><i class="bi bi-funnel"></i> Filter</button>
    </form>

    <div class="admin-table-shell">
        <table class="admin-table admin-table--responsive">
            <thead>
                <tr>
                    <th>Reference</th>
                    <th>Order</th>
                    <th>Customer</th>
                    <th>Method</th>
                    <th>Rx Status</th>
                    <th class="admin-table__numeric">Amount</th>
                    <th>Payment Status</th>
                    <th>Order Status</th>
                    <th>Recorded</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Payments.Count == 0)
                {
                    <tr><td colspan="10" class="admin-table__empty">No payment records matched the current filters.</td></tr>
                }
                else
                {
                    @foreach (var payment in Model.Payments)
                    {
                        <tr>
                            <td data-label="Reference">
                                <strong>@payment.ReferenceNumber</strong>
                                <span>@payment.Provider</span>
                            </td>
                            <td data-label="Order">@payment.OrderNumber</td>
                            <td data-label="Customer">@payment.CustomerName</td>
                            <td data-label="Method">@AdminViewHelper.PaymentMethodLabel(payment.PaymentMethod)</td>
                            <td data-label="Rx Status">
                                <span class="@AdminViewHelper.PrescriptionStatusClass(payment.RequiresPrescription ? payment.PrescriptionStatus : "NotRequired")">
                                    @(payment.RequiresPrescription ? payment.PrescriptionStatus : "NotRequired")
                                </span>
                            </td>
                            <td data-label="Amount" class="admin-table__numeric">PHP @payment.Amount.ToString("N2")</td>
                            <td data-label="Payment Status">
                                <span class="@AdminViewHelper.StatusClass(payment.Status)">@payment.Status</span>
                            </td>
                            <td data-label="Order Status">
                                <span class="@AdminViewHelper.StatusClass(payment.OrderStatus)">@payment.OrderStatus</span>
                            </td>
                            <td data-label="Recorded">@payment.CreatedAtUtc.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</td>
                            <td data-label="Action">
                                @if (!Model.AllowPaymentUpdates)
                                {
                                    <span class="text-muted small">Read only</span>
                                }
                                else if (payment.PaymentId <= 0)
                                {
                                    <span class="text-muted small">No payment record</span>
                                }
                                else if (!payment.CanProceed)
                                {
                                    <span class="text-danger small">@payment.BlockingReason</span>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger admin-icon-button"
                                            data-bs-toggle="modal"
                                            data-bs-target="#paymentStatusModal"
                                            data-payment-id="@payment.PaymentId"
                                            data-payment-order="@payment.OrderNumber"
                                            data-payment-customer="@payment.CustomerName"
                                            data-payment-status="@payment.Status"
                                            aria-label="Update payment status"
                                            title="Update payment status">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.Pagination is not null)
    {
        <partial name="~/Views/Shared/_AdminPagination.cshtml" model="Model.Pagination" />
    }
</section>

<div class="modal fade" id="paymentStatusModal" tabindex="-1" aria-labelledby="paymentStatusModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content admin-modal">
            <form method="post" action="@Url.Action("UpdatePaymentStatus", Model.ModuleController)">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title" id="paymentStatusModalLabel">Update Payment Status</h5>
                        <p class="admin-modal__caption" data-payment-status-caption>Select the new status for this payment.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="PaymentId" data-payment-status-id />
                    <label class="form-label" for="paymentStatusSelect">Status</label>
                    <select class="form-select" id="paymentStatusSelect" name="Status" data-payment-status-select>
                        @foreach (var updateStatus in updateStatuses)
                        {
                            <option value="@updateStatus">@updateStatus</option>
                        }
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-danger" type="submit">
                        <i class="bi bi-save"></i> Save Status
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
