@model PharmacyPOS.Models.Admin.AdminModuleViewModel
@{
    var pagination = Model.Pagination;
    var totalThreads = pagination?.TotalItems ?? Model.MessageThreads.Count;
    var hasSearch = !string.IsNullOrWhiteSpace(Model.Search);
}

<section class="pharm-chat-shell">
    <aside class="pharm-chat-sidebar">
        <header class="pharm-chat-sidebar__header">
            <div>
                <p class="pharm-chat-sidebar__eyebrow">Customer Inbox</p>
                <h4>Order Chats</h4>
            </div>
            <span class="pharm-chat-sidebar__count">@totalThreads order@(totalThreads == 1 ? string.Empty : "s")</span>
        </header>

        <form method="get"
              asp-controller="@Model.ModuleController"
              asp-action="Messages"
              class="pharm-chat-search"
              role="search">
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="pageSize" value="@(pagination?.PageSize ?? 10)" />
            <label class="visually-hidden" for="message-thread-search">Search order chats</label>
            <div class="pharm-chat-search__row">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input id="message-thread-search"
                       class="form-control"
                       type="search"
                       name="search"
                       value="@Model.Search"
                       placeholder="Search customer, order, status..." />
                <button class="btn btn-danger" type="submit">Search</button>
            </div>
            @if (hasSearch)
            {
                <a class="pharm-chat-search__clear"
                   asp-controller="@Model.ModuleController"
                   asp-action="Messages"
                   asp-route-pageSize="@(pagination?.PageSize ?? 10)">
                    Clear search
                </a>
            }
        </form>

        <div class="pharm-chat-list">
            @if (Model.MessageThreads.Count == 0)
            {
                <div class="admin-empty-state">
                    @(hasSearch ? "No order chats match your search." : "No customer order chats have started yet.")
                </div>
            }
            else
            {
                @foreach (var thread in Model.MessageThreads)
                {
                    <a class="pharm-chat-thread @(Model.SelectedThreadId == thread.Id ? "pharm-chat-thread--active" : string.Empty)"
                       asp-controller="@Model.ModuleController"
                       asp-action="Messages"
                       asp-route-threadId="@thread.Id"
                       asp-route-search="@Model.Search"
                       asp-route-page="@(pagination?.CurrentPage ?? 1)"
                       asp-route-pageSize="@(pagination?.PageSize ?? 10)">
                        <div class="pharm-chat-thread__avatar">
                            @(thread.CustomerName.Length >= 2 ? thread.CustomerName[..2].ToUpperInvariant() : thread.CustomerName.ToUpperInvariant())
                        </div>
                        <div class="pharm-chat-thread__body">
                            <div class="pharm-chat-thread__topline">
                                <strong>@thread.OrderReference</strong>
                                <span>@thread.UpdatedAtUtc.ToLocalTime().ToString("MMM dd")</span>
                            </div>
                            <p>@thread.CustomerName | @thread.OrderStatus</p>
                            <small>@thread.LastMessagePreview</small>
                        </div>
                        @if (thread.NeedsReply)
                        {
                            <span class="pharm-chat-thread__badge">Reply</span>
                        }
                    </a>
                }
            }
        </div>

        @if (pagination is not null)
        {
            <div class="pharm-chat-pagination">
                <partial name="~/Views/Shared/_AdminPagination.cshtml" model="pagination" />
            </div>
        }
    </aside>

    <section class="pharm-chat-main">
        @if (Model.ActiveMessageThread is null)
        {
            <div class="pharm-chat-main__empty">
                <div>
                    <h4>No order selected</h4>
                    <p>Select an order from the left to read the conversation and send a reply.</p>
                </div>
            </div>
        }
        else
        {
            <header class="pharm-chat-main__header">
                <div class="pharm-chat-main__identity">
                    <div class="pharm-chat-thread__avatar pharm-chat-thread__avatar--large">
                        @(Model.ActiveMessageThread.CustomerName.Length >= 2 ? Model.ActiveMessageThread.CustomerName[..2].ToUpperInvariant() : Model.ActiveMessageThread.CustomerName.ToUpperInvariant())
                    </div>
                    <div>
                        <h4>@Model.ActiveMessageThread.CustomerName</h4>
                        <p>Order @Model.ActiveMessageThread.OrderNumber | Ref @Model.ActiveMessageThread.OrderReference</p>
                    </div>
                </div>
                <div class="text-end">
                    <div><strong>@Model.ActiveMessageThread.OrderStatus</strong></div>
                    <small>@Model.ActiveMessageThread.MessageCount message@(Model.ActiveMessageThread.MessageCount == 1 ? string.Empty : "s")</small>
                </div>
            </header>

            <div class="pharm-chat-scroll">
                @if (Model.ActiveMessageThread.Messages.Count == 0)
                {
                    <div class="admin-empty-state">No messages yet for this order.</div>
                }
                else
                {
                    @foreach (var message in Model.ActiveMessageThread.Messages)
                    {
                        <article class="pharm-chat-bubble @(!message.IsCustomerMessage && !message.IsSystemMessage ? "pharm-chat-bubble--self" : string.Empty)">
                            <header>
                                <strong>@message.SenderName</strong>
                                <span>
                                    @(message.SentAtUtc?.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt") ?? "Pending timestamp")
                                </span>
                            </header>
                            <p>@message.Body</p>
                            <small>@message.SenderRole</small>
                        </article>
                    }
                }
            </div>

            <form method="post" action="@Url.Action("SendMessage", Model.ModuleController)" class="pharm-chat-composer">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ThreadId" value="@Model.SelectedThreadId" />
                <div class="pharm-chat-composer__row">
                    <textarea class="form-control" name="Body" rows="3" placeholder="Type your reply about this order"></textarea>
                    <button class="btn btn-danger" type="submit">
                        <i class="bi bi-send"></i>
                        <span>Send</span>
                    </button>
                </div>
            </form>
        }
    </section>
</section>
